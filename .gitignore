# ── Internal planning docs (not a deliverable) ──
build.md

# ── Raw & processed data (large binary files; never commit raw TLC Parquet) ──
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json    # Committed: proof-of-retrieval metadata (checksums, row counts, URLs)
data/processed/*
!data/processed/.gitkeep
!data/processed/validation_report_*.json   # Committed: evidence artifact (flag counts, profile, KUAL)

# ── Reference data (fetched by ingest.py — commit so graders can see zone lookup) ──
data/reference/*
!data/reference/.gitkeep
!data/reference/taxi_zones_socrata.json   # Committed: small Socrata API result (263 rows)
!data/reference/taxi_zone_lookup.csv      # Committed: fallback zone CSV

# ── Pipeline outputs (CSV metrics committed; large generated files gitignored) ──
outputs/*
!outputs/.gitkeep
!outputs/*.csv    # Committed: metric tables are required deliverables

# ── Pipeline log files (auto-generated per run) ──
logs/*
!logs/.gitkeep

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ──
.venv/
venv/
env/
.env

# ── Jupyter ──
.ipynb_checkpoints/
notebooks/.ipynb_checkpoints/

# ── OS artifacts ──
.DS_Store
Thumbs.db

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo

# ── DuckDB (local in-memory DB files, re-created on each run) ──
*.duckdb
*.duckdb.wal
